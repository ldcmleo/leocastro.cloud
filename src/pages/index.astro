---
import MainLayout from "../layouts/mainLayout.astro";
import Footer from "../components/footer.astro";
import ContactForm from "../components/contact-form.astro";
---

<MainLayout Title="Leonardo Castro — Desarrollo de Software & Consultoría Tecnológica">
    <div class="granulado"></div>

    {/* Hero */}
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
        <div class="bg-square"></div>
        <div class="box relative z-10 px-6 py-20 text-center">
            <img
                src="/images/profile.webp"
                alt="Leonardo Castro"
                class="w-24 h-24 rounded-full mx-auto mb-8 border-2 border-[#a9b4c6] object-cover"
            />
            <h1 class="text-5xl md:text-6xl lg:text-7xl mb-6 tracking-tight">
                Leonardo Castro
            </h1>
            <p class="text-xl md:text-2xl text-[#a9b4c6] mb-4 font-light">
                Desarrollador de Software & Consultor Tecnológico
            </p>
            <p class="text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed opacity-80">
                Transformo ideas en soluciones digitales robustas. Desde desarrollo web hasta chatbots inteligentes con IA, ofrezco tecnología que impulsa tu negocio.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="#servicios"
                    class="inline-flex items-center justify-center px-8 py-4 bg-[#883AEA] text-white font-medium hover:bg-[#7a2fe0] transition-all duration-300"
                >
                    <span>Ver servicios</span>
                    <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </a>
                <a
                    href="#contacto"
                    class="inline-flex items-center justify-center px-8 py-4 border border-[#a9b4c6] hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-all duration-300"
                >
                    Contactar
                </a>
            </div>
        </div>
    </section>

    {/* Servicios */}
    <section id="servicios" class="relative z-10 px-6 py-24">
        <div class="box">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl mb-4">Servicios</h2>
                <p class="text-lg opacity-70 max-w-xl mx-auto">
                    Soluciones tecnológicas completas para empresas y startups que buscan crecer con tecnología de calidad.
                </p>
            </div>

            {/* Servicio destacado: Chatbots IA */}
            <div class="mb-16 p-8 md:p-12 border border-[#883AEA] bg-[#883AEA]/5 dark:bg-[#883AEA]/10">
                <div class="flex flex-col md:flex-row gap-8 items-start">
                    <div class="flex-shrink-0">
                        <div class="w-16 h-16 flex items-center justify-center bg-[#883AEA]/20">
                            <svg class="w-8 h-8 text-[#883AEA]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-3">
                            <h3 class="text-2xl md:text-3xl">Chatbots Inteligentes con IA</h3>
                            <span class="px-3 py-1 text-xs font-medium bg-[#883AEA] text-white">Destacado</span>
                        </div>
                        <p class="text-lg opacity-80 mb-4 leading-relaxed">
                            Desarrollo asistentes virtuales con inteligencia artificial que automatizan la atención al cliente, agendan citas, responden consultas y generan leads — 24/7, sin descanso. Integrados con WhatsApp, web, o cualquier canal que necesites.
                        </p>
                        <ul class="space-y-2 opacity-70">
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#883AEA] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                Entrenados con tu información y tono de marca
                            </li>
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#883AEA] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                Integración con WhatsApp, Telegram, y tu sitio web
                            </li>
                            <li class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-[#883AEA] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                Conectados a tu CRM, base de datos, o APIs existentes
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            {/* Otros servicios */}
            <div class="grid md:grid-cols-2 gap-8">
                {/* Desarrollo de Software */}
                <div class="p-8 border border-[#a9b4c6] hover:border-[#883AEA] transition-all duration-300 group">
                    <div class="w-12 h-12 flex items-center justify-center mb-5 opacity-60 group-hover:opacity-100 transition-opacity">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl mb-3">Desarrollo de Software</h3>
                    <p class="opacity-70 leading-relaxed mb-4">
                        Aplicaciones web y de escritorio construidas con tecnologías modernas: Go, React, Node.js. Código limpio, bien testeado y documentado.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Go</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">React</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Node.js</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">PostgreSQL</span>
                    </div>
                </div>

                {/* Diseño de Páginas Web */}
                <div class="p-8 border border-[#a9b4c6] hover:border-[#883AEA] transition-all duration-300 group">
                    <div class="w-12 h-12 flex items-center justify-center mb-5 opacity-60 group-hover:opacity-100 transition-opacity">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h10.5m-10.5 9.75h10.5"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl mb-3">Diseño de Páginas Web</h3>
                    <p class="opacity-70 leading-relaxed mb-4">
                        Sitios web modernos, rápidos y responsivos. Desde landing pages hasta portales complejos, con diseño que convierte visitantes en clientes.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Astro</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Tailwind</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Responsive</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">SEO</span>
                    </div>
                </div>

                {/* Gestión de Infraestructura */}
                <div class="p-8 border border-[#a9b4c6] hover:border-[#883AEA] transition-all duration-300 group">
                    <div class="w-12 h-12 flex items-center justify-center mb-5 opacity-60 group-hover:opacity-100 transition-opacity">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 17.25v-.228a4.5 4.5 0 00-.12-1.03l-2.268-9.64a3.375 3.375 0 00-3.285-2.602H7.923a3.375 3.375 0 00-3.285 2.602l-2.268 9.64a4.5 4.5 0 00-.12 1.03v.228m19.5 0a3 3 0 01-3 3H5.25a3 3 0 01-3-3m19.5 0a3 3 0 00-3-3H5.25a3 3 0 00-3 3m16.5 0h.008v.008h-.008v-.008zm-3 0h.008v.008h-.008v-.008zM5.25 5.25h13.5C21.05 5.25 21.75 6 21.75 6.75v10.5c0 .75-.7 1.5-1.5 1.5H5.25c-.8 0-1.5-.75-1.5-1.5V6.75c0-.75.7-1.5 1.5-1.5z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl mb-3">Gestión de Infraestructura</h3>
                    <p class="opacity-70 leading-relaxed mb-4">
                        Administración de servidores, migración a la nube, CI/CD, monitoreo y seguridad. Infraestructura tradicional y cloud (AWS, GCP, Azure) que escala con tu negocio.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">AWS</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Docker</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Linux</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">CI/CD</span>
                    </div>
                </div>

                {/* Software a la Medida */}
                <div class="p-8 border border-[#a9b4c6] hover:border-[#883AEA] transition-all duration-300 group">
                    <div class="w-12 h-12 flex items-center justify-center mb-5 opacity-60 group-hover:opacity-100 transition-opacity">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.049.58.025 1.193-.14 1.743"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl mb-3">Software a la Medida</h3>
                    <p class="opacity-70 leading-relaxed mb-4">
                        Sistemas diseñados específicamente para tus procesos de negocio. Desde CRM personalizados hasta plataformas de gestión interna, construidos para resolver tus problemas reales.
                    </p>
                    <div class="flex flex-wrap gap-2">
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Análisis</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Diseño</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Desarrollo</span>
                        <span class="px-2 py-1 text-xs border border-[#a9b4c6] opacity-60">Soporte</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* Por qué elegirme */}
    <section class="relative z-10 px-6 py-24 bg-[#080808]/5 dark:bg-[#EEF0F2]/5">
        <div class="box">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl mb-4">¿Por qué trabajar conmigo?</h2>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="text-center">
                    <div class="text-4xl mb-3 opacity-60">
                        <i class="nf nf-fa-code"></i>
                    </div>
                    <h3 class="text-lg mb-2">Código de Calidad</h3>
                    <p class="opacity-70 text-sm leading-relaxed">
                        Código limpio, bien testeado y documentado. Arquitectura que escala y se mantiene sin dolor.
                    </p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-3 opacity-60">
                        <i class="nf nf-fa-clock"></i>
                    </div>
                    <h3 class="text-lg mb-2">Entrega a Tiempo</h3>
                    <p class="opacity-70 text-sm leading-relaxed">
                        Comunicación constante, hitos claros y entregas puntuales. Sin sorpresas ni retrasos injustificados.
                    </p>
                </div>
                <div class="text-center">
                    <div class="text-4xl mb-3 opacity-60">
                        <i class="nf nf-fa-headphones"></i>
                    </div>
                    <h3 class="text-lg mb-2">Soporte Continuo</h3>
                    <p class="opacity-70 text-sm leading-relaxed">
                        No desaparezo después de la entrega. Soporte post-lanzamiento y mantenimiento para que tu sistema funcione siempre.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {/* Contacto */}
    <section id="contacto" class="relative z-10 px-6 py-24">
        <div class="box">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl mb-4">¿Tienes un proyecto en mente?</h2>
                <p class="text-lg opacity-70 max-w-xl mx-auto">
                    Cuéntame sobre tu proyecto y te respondo en menos de 24 horas.
                </p>
            </div>
            <div class="max-w-lg mx-auto">
                <ContactForm />
            </div>

            {/* Links sociales */}
            <div class="mt-16 text-center">
                <p class="text-sm opacity-60 mb-4">O encuéntrame en</p>
                <div class="flex justify-center gap-6">
                    <a
                        target="_blank"
                        href="https://cv.leocastro.cloud"
                        class="w-12 h-12 flex items-center justify-center border border-[#a9b4c6] hover:border-[#883AEA] hover:text-[#883AEA] transition-all duration-300"
                        aria-label="Ver CV"
                    >
                        <i class="nf nf-md-file_document text-lg"></i>
                    </a>
                    <a
                        target="_blank"
                        href="https://www.linkedin.com/in/ldcmleo/"
                        class="w-12 h-12 flex items-center justify-center border border-[#a9b4c6] hover:border-[#883AEA] hover:text-[#883AEA] transition-all duration-300"
                        aria-label="LinkedIn"
                    >
                        <i class="nf nf-dev-linkedin text-lg"></i>
                    </a>
                    <a
                        target="_blank"
                        href="https://www.github.com/ldcmleo"
                        class="w-12 h-12 flex items-center justify-center border border-[#a9b4c6] hover:border-[#883AEA] hover:text-[#883AEA] transition-all duration-300"
                        aria-label="GitHub"
                    >
                        <i class="nf nf-dev-github text-lg"></i>
                    </a>
                    <a
                        href="/blog"
                        class="w-12 h-12 flex items-center justify-center border border-[#a9b4c6] hover:border-[#883AEA] hover:text-[#883AEA] transition-all duration-300"
                        aria-label="Blog"
                    >
                        <i class="nf nf-fa-pencil text-lg"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <Footer />

    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
</MainLayout>
